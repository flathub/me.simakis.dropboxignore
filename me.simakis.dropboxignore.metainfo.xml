    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <name>dropboxignore</name>
    <summary>It's all about the missing .dropboxignore file</summary>
    <description>
        <p>This CLI shell script aims to take advantage of glob patterns and existing .gitignore files in order to
            exclude specific folders and files from  dropbox sync. The shell script uses this recent approach to ignore
            the matched folders and files.
        </p>
    </description>
    <url type="homepage">https://github.com/sp1thas/dropboxignore</url>
    <url type="bugtracker">https://github.com/sp1thas/dropboxignore/issues</url>
    <url type="vcs-browser">https://github.com/sp1thas/dropboxignore</url>
    <url type="contact">https://simakis.me/contact</url>
    <launchable type="desktop-id">me.simakis.dropboxignore.desktop</launchable>
    <developer id="me.simakis">
